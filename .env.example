# Optional. On Vercel the AI Gateway authenticates via OIDC automatically; locally set a gateway key.
AI_GATEWAY_API_KEY=your-ai-gateway-key-here
# Optional comma-separated model list tried in order (Vercel AI Gateway model strings).
AGENT_MODELS=xai/grok-4-fast-non-reasoning,openai/gpt-4o-mini
# Optional direct xAI fallback if the gateway is unavailable (placeholder only).
XAI_API_KEY=your-xai-key-here
# Optional data API keys for lib/dataTools.ts (placeholders only). FEC and Congress.gov fall back to DEMO_KEY (low rate limit).
FEC_API_KEY=your-api-data-gov-key-here
CONGRESS_API_KEY=your-api-data-gov-key-here
